Technician’s Tools
1.	Create a second batch file inside “Menu” folder “notepad C:\WinPE_amd64\Mount\Menu\WinPE_Tools_Menu.cmd” to use the “WinPE” tools.
@echo off
title WinPE Tools

:MENU
cls
echo ==================================
echo WinPE TOOLS
echo ==================================
echo.
echo 1. Notepad
echo 2. DiskPart
echo 3. Registry Editor
echo 4. Command Prompt
echo 5. Files Browser
echo 6. Back to Main Menu
echo.
choice /c 123456 /n /m "Select an option: "

if errorlevel 6 exit /b
if errorlevel 5 Z:\Tools\Explorer64++.exe
if errorlevel 4 cmd
if errorlevel 3 regedit
if errorlevel 2 diskpart
if errorlevel 1 notepad

goto MENU

2.	Create a batch file inside the “Menu” folder “notepad C:\WinPE_amd64\Mount\Menu\Tools_Menu.cmd” to read the contents of “Tools” folder from the USB drive and list them as menu to simplify running the tools.
@echo off
setlocal EnableDelayedExpansion

:: Enable ANSI escape character
for /f %%a in ('echo prompt $E^| cmd') do set "ESC=%%a"

set "ToolDir=Z:\Tools"

:MENU
cls

echo %ESC%[96m========================================================
echo WINPE TOOLS LAUNCHER
echo ========================================================%ESC%[0m
echo.

set Count=0

for %%F in ("%ToolDir%\*.exe") do (
set /a Count+=1
set "Tool!Count!=%%~fF"

echo %ESC%[93m!Count!.%ESC%[97m %%~nF
)

echo.
echo %ESC%[91m0.%ESC%[97m Exit
echo.

set /p Choice=%ESC%[92mSelect Tool Number: %ESC%[0m

if "%Choice%"=="0" exit /b

if not defined Tool%Choice% (
echo.
echo %ESC%[91mInvalid Selection!%ESC%[0m
timeout /t 2 >nul
goto MENU
)

set "Selected=!Tool%Choice%!"

cls
echo %ESC%[92mLaunching:%ESC%[0m
echo !Selected!
echo.

start "" "!Selected!"

timeout /t 1 >nul
goto MENU

